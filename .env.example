# Safe development defaults only.
# Copy this file to .env and set environment-specific values locally.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_HOST empty to use SQLite for local development.
DB_HOST=
DB_PORT=5432
DB_NAME=content_tracker
DB_USER=content_tracker
DB_PASSWORD=

# Runtime source definitions. Deployment decides the actual path.
CONTENT_TRACKER_SOURCES_FILE=

# Keep the browser API URL relative in development and production.
VITE_API_BASE_URL=/api
# Vite only: local reverse-proxy target used by npm run dev.
VITE_DEV_PROXY_TARGET=http://localhost:8000
