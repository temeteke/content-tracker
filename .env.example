# Safe development defaults only.
# The Dev Container and the root compose file use this file through .env.
# .env is git-ignored; copy this file and change values as needed.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by the root compose stack. Leave DB_HOST empty to use SQLite when running
# the backend directly on the host; compose overrides DB_HOST with the db service.
DB_HOST=
DB_PORT=5432
DB_NAME=content_tracker
DB_USER=content_tracker
DB_PASSWORD=content_tracker

# Optional Traefik hostname suffix for the production-equivalent stack.
# Keep the default for content-tracker.localhost; set a custom suffix,
# e.g. dev.localhost, when a distinct local hostname namespace is useful.
TRAEFIK_HOST_SUFFIX=localhost

# Runtime source definitions. Deployment decides the actual path.
CONTENT_TRACKER_SOURCES_FILE=

# Keep the browser API URL relative in development and production.
VITE_API_BASE_URL=/api
# Vite dev server reverse-proxy target. Compose overrides this for the dev frontend.
VITE_DEV_PROXY_TARGET=http://localhost:8000
