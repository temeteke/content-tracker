{
  "name": "content-tracker",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "workspace",
  "runServices": ["db", "backend", "frontend"],
  "workspaceFolder": "/workspaces/content-tracker",
  "initializeCommand": "bash -c '[ -f .env ] || cp .env.example .env'",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "forwardPorts": ["backend:8000", "frontend:5173"],
  "portsAttributes": {
    "backend:8000": {
      "label": "Django API"
    },
    "frontend:5173": {
      "label": "Vite frontend"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "Vue.volar"
      ]
    }
  }
}
